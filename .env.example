# Copy to .env and set values. Used by docker compose / podman compose for the backend.
# Do not commit .env.

# JWT signing secret (required). Use a long random string in production.
JWT_SECRET=your-secret-here

# Public base URL the app is served from (required). Used to build links handed
# to users, such as password reset links. A trailing slash is ignored.
APP_BASE_URL=http://localhost

# Optional: for production HTTPS, set your domain in the Caddyfile (replace http://localhost
# with https://yourdomain.com). Caddy will obtain Let's Encrypt certs automatically.
